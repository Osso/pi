{
	"$schema": "https://biomejs.dev/schemas/2.3.5/schema.json",
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"style": {
				"noNonNullAssertion": "off",
				"useConst": "error",
				"useNodejsImportProtocol": "off"
			},
			"suspicious": {
				"noExplicitAny": "off",
				"noControlCharactersInRegex": "off",
				"noEmptyInterface": "off"
			}
		}
	},
	"formatter": {
		"enabled": true,
		"formatWithErrors": false,
		"indentStyle": "tab",
		"indentWidth": 3,
		"lineWidth": 120
	},
	"files": {
		"includes": [
			"packages/*/src/**/*.ts",
			"packages/*/test/**/*.ts",
			"packages/coding-agent/examples/**/*.ts",
			"packages/coding-agent/extensions/**/*.ts",
			"!**/node_modules/**/*",
			"!**/test-sessions.ts",
			"!**/models.generated.ts",
			"!**/*.models.ts",
			"!packages/coding-agent/extensions/**/*.d.ts",
			"!packages/mom/data/**/*",
			"!!**/node_modules"
		]
	},
	"overrides": [
		{
			"includes": ["packages/tui/src/**/*.ts", "packages/orchestrator/src/**/*.ts"],
			"linter": {
				"rules": {
					"style": {
						"noNonNullAssertion": "error"
					},
					"suspicious": {
						"noExplicitAny": "error"
					}
				}
			}
		},
		{
			"includes": ["packages/ai/src/**/*.ts"],
			"linter": {
				"rules": {
					"style": {
						"noNonNullAssertion": "error"
					},
					"suspicious": {
						"noExplicitAny": "error"
					}
				}
			}
		},
		{
			"includes": ["packages/agent-core/src/**/*.ts"],
			"linter": {
				"rules": {
					"style": {
						"noNonNullAssertion": "error"
					},
					"suspicious": {
						"noExplicitAny": "error"
					}
				}
			}
		},
		{
			"includes": ["packages/coding-agent/src/**/*.ts"],
			"linter": {
				"rules": {
					"style": {
						"noNonNullAssertion": "error"
					},
					"suspicious": {
						"noExplicitAny": "error"
					}
				}
			}
		},
		{
			"includes": ["packages/coding-agent/extensions/**/*.ts"],
			"linter": {
				"rules": {
					"style": {
						"noNonNullAssertion": "error"
					},
					"suspicious": {
						"noExplicitAny": "error"
					}
				}
			}
		}
	]
}
