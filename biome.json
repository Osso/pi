{
	"$schema": "https://biomejs.dev/schemas/2.3.5/schema.json",
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"style": {
				"noNonNullAssertion": "error",
				"useConst": "error",
				"useNodejsImportProtocol": "off"
			},
			"suspicious": {
				"noExplicitAny": "error",
				"noControlCharactersInRegex": "off",
				"noEmptyInterface": "off"
			}
		}
	},
	"formatter": {
		"enabled": true,
		"formatWithErrors": false,
		"indentStyle": "tab",
		"indentWidth": 3,
		"lineWidth": 120
	},
	"files": {
		"includes": [
			"packages/*/src/**/*.ts",
			"packages/*/test/**/*.ts",
			"packages/coding-agent/examples/**/*.ts",
			"packages/coding-agent/extensions/**/*.ts",
			"packages/coding-agent/extensions/**/*.mjs",
			"packages/coding-agent/extensions/**/*.cjs",
			"scripts/browser-smoke-entry.ts",
			"scripts/check-browser-smoke.mjs",
			"scripts/check-file-size-ratchet.mjs",
			"scripts/check-lockfile-commit.mjs",
			"scripts/check-pinned-deps.mjs",
			"scripts/check-ts-relative-imports.mjs",
			"scripts/claude-runtime.mjs",
			"scripts/claude-runtime.test.mjs",
			"scripts/coding-agent-lock-paths.mjs",
			"scripts/generate-coding-agent-install-lock.mjs",
			"scripts/generate-coding-agent-shrinkwrap.mjs",
			"scripts/smoke-archived-session-open.mjs",
			"scripts/smoke-local-release.mjs",
			"scripts/test-coding-agent-lock-generators.mjs",
			"!**/node_modules/**/*",
			"!**/test-sessions.ts",
			"!**/models.generated.ts",
			"!**/*.models.ts",
			"!packages/coding-agent/extensions/**/*.d.ts",
			"!packages/mom/data/**/*",
			"!!**/node_modules"
		]
	}
}
